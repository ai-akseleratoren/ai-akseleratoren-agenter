# Kursopptak — kopier til .env i mappa du kjører skriptet fra. ALDRI i git.

# Zoom Server-to-Server OAuth-app (Zoom Marketplace), scope cloud_recording:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Zoom-brukerne som kan være vert for sendingene, kommaseparert
# (f.eks. en felles support-bruker og din egen)
ZOOM_VERTER=

# Ord i møtetittelen som betyr «kurssending», kommaseparert
# (f.eks. labs,velkommen til nye medlemmer,bonus)
SENDING_EMNER=

# Hvor opptakene lagres (standard: ./opptak). Hold mappa utenfor git.
OPPTAK_MAPPE=
