# Alfred (e-postagenten) — tilgang til innboksene dine.
# Kopier til .env og fyll inn. Legg fila UTENFOR repoet (f.eks. ~/.alfred/.env)
# og ALDRI i git. Oppbevar verdiene i en passordbehandler.

# Fra en OAuth-klient av typen «Desktop app» i Google Cloud Console.
# Samme klient brukes for alle kontoene. Be om scopen gmail.modify —
# den gir lesing, etiketter og papirkurv, men NEKTER permanent sletting.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Hvor tokens og logger lagres (én token-fil per konto). Utenfor repoet.
ALFRED_HOME=~/.alfred

# Valgfritt: IMAP-fallback for kontoer som ikke kan OAuth-kobles.
# Krever app-passord. OAuth er å foretrekke — app-passord gir full
# IMAP-tilgang, inkludert permanent sletting.
# IMAP_USER=eksempel@dinbedrift.no
# IMAP_APP_PASSWORD=
# IMAP_SERVER=imap.dinbedrift.no

# Valgfritt: kanalen den daglige meldingen sendes i
# ALFRED_SLACK_WEBHOOK=
