# Alfred (e-postagenten) — nøkler for tilgang til innboksene.
# Legges UTENFOR repoet (f.eks. ~/.alfred/.env). ALDRI i git.

# Google OAuth-klient (opprettes i Google Cloud Console, scope gmail.modify —
# den scopen kan IKKE slette permanent, kun papirkurv/etiketter)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Refresh-tokens per konto lagres av OAuth-flyten i egen tokens/-mappe

# Fallback: IMAP med app-passord (gir full tilgang inkl. sletting — OAuth er
# å foretrekke). Én blokk per konto som må bruke IMAP.
IMAP_HOST=
IMAP_USER=
IMAP_APP_PASSWORD=

# Slack (valgfritt) — for den daglige 📬-meldingen
SLACK_BOT_TOKEN=
SLACK_DM_CHANNEL=
