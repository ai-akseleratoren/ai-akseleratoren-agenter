# Kopier til .env i prosjektrota og fyll inn. .env skal ALDRI i git.

# --- E-post (IMAP/SMTP). Gmail: app-passord, krever 2-trinns bekreftelse
EPOST_USER=
EPOST_APP_PASSWORD=
EPOST_IMAP=imap.gmail.com
EPOST_SMTP=smtp.gmail.com
# Gmail: "[Gmail]/Drafts" og "[Gmail]/Sent Mail". Andre: "Drafts" og "Sent"
EPOST_UTKAST_MAPPE=[Gmail]/Drafts
EPOST_SENDT_MAPPE=[Gmail]/Sent Mail

# --- CRM. Én av: ghl | hubspot | salesforce | kajabi | ingen
CRM=ingen
GHL_TOKEN=
GHL_LOCATION_ID=
HUBSPOT_TOKEN=
SALESFORCE_DOMENE=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
KAJABI_TOKEN=

# --- Meta (Messenger + Instagram-DM), egen app, ikke via CRM-innboksen
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_ID=
