# Warren (CFO-agenten) — nøkler for lesetilgang til tallkildene.
# Kopier til .env i repo-roten og fyll inn. ALDRI sjekk .env inn i git.
# Bruk read-only-nøkler der leverandøren tilbyr det.

# Stripe (eller din betalingsleverandør) — innbetalinger og saldo.
# Begrenset nøkkel: les Charges, Balance, Balance transactions, Payouts, Invoices, Subscriptions
STRIPE_API_KEY=

# Wise / bank-API — kontosaldo og direkte innbetalinger
WISE_API_TOKEN=

# Meta Ads — annonseforbruk forrige uke (dropp hvis du ikke annonserer)
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=

# CRM (f.eks. GoHighLevel) — pipeline/salgsverdi (valgfritt)
CRM_API_TOKEN=
