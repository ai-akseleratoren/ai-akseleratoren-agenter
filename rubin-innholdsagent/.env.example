# Rubin — kun for YouTube-modusen. rubin_mcp.py leser disse som miljøvariabler:
# gi dem med `claude mcp add rubin -e NAVN=verdi ...`. ALDRI sjekk nøkler inn i git.

# YouTube Data API v3 (Google Cloud Console). Leser bare offentlige data.
# Uten nøkkel virker alt unntatt den ukentlige outlier-skannen.
YOUTUBE_API_KEY=

# Hvor tavla og dokumentene lagres (valgfritt, standard ~/.rubin)
RUBIN_HOME=
