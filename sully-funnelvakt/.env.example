# Funnelvakten — kopier til .env i repo-roten og fyll inn.
# ALDRI sjekk .env inn i git. Bruk read-only-nøkler der leverandøren tilbyr det.

# Kilde til sannhet for HVEM som har en funnel og HVILKE sider de har.
# F.eks. en Notion-database, et regneark eller et CRM. Lesetilgang holder.
# Har du bare én funnel, trenger du ikke dette i det hele tatt.
KUNDEREGISTER_TOKEN=

# Meta — for å slå opp annonsestatus mot webinarvinduet (valgfritt)
META_ADS_TOKEN=

# CRM — for å avstemme påmeldte mot tagger og telle sendte mailer (valgfritt)
CRM_API_TOKEN=
CRM_LOCATION_ID=

# Webinarplattform — for oppmøtetall rett etter sendingen (valgfritt)
WEBINAR_API_KEY=

# Hvor rapporten skal varsles
SLACK_WEBHOOK_URL=
SLACK_KANAL=#funnelvakt
