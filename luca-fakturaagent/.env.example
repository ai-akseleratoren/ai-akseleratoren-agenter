# Luca (fakturaagenten). Kopier til .env og fyll inn. ALDRI sjekk .env inn i git.
# Gi Luca minst mulig tilgang: lesing + oppretting av utkast holder.

# GoHighLevel: Private Integration Token med invoices (les+skriv) og contacts (les)
GHL_TOKEN=
GHL_LOCATION_ID=

# Avsender og kopi på fakturaer. Bruk en adresse et menneske faktisk leser.
INVOICE_FROM_NAME=
INVOICE_FROM_EMAIL=
INVOICE_CC_EMAIL=
# Landkode når kontakten mangler land (NO, SE, DK ...)
INVOICE_DEFAULT_COUNTRY=NO

# Stripe: begrenset nøkkel med lesetilgang til subscriptions, invoices, charges, customers
STRIPE_API_KEY=
# Kjøpssiden kunder sendes til når Stripe har kansellert (winback)
REBUY_URL=
# Navnet som står under purreutkastene
SIGNATUR=

# Valgfritt: hvor rapportene skrives (standard: ./faktura)
FAKTURA_DIR=
