# Luca (fakturaagenten) — nøkler til faktura- og betalingssystemene dine.
# Kopier til .env i repo-roten og fyll inn. ALDRI sjekk .env inn i git.
# Gi Luca minst mulig tilgang: lesing + oppretting av utkast holder.

# Faktura-/CRM-systemet (f.eks. GoHighLevel, Fiken, Tripletex)
# — her opprettes fakturautkastene og herfra leses utestående.
INVOICE_API_TOKEN=
INVOICE_ACCOUNT_ID=

# Betalingsleverandør (f.eks. Stripe) — innbetalinger å matche mot fakturaer
PAYMENT_API_KEY=

# Bank-/Wise-API — hva som faktisk har landet på konto (valgfritt)
BANK_API_TOKEN=

# Kanalen der utkast venter på et ja (f.eks. Slack incoming webhook)
APPROVAL_CHANNEL_WEBHOOK=

# Fast avsenderadresse på utgående fakturaer, og hvem som alltid står på kopi
INVOICE_FROM_EMAIL=faktura@dinbedrift.no
INVOICE_CC_EMAIL=regnskap@dinbedrift.no
