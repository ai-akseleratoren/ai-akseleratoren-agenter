# North Star — kopier til .env i repo-roten og fyll inn. ALDRI sjekk .env inn i git.
# Bruk lesenøkler der leverandøren tilbyr det. North Star skal bare lese.

# Betalingsløsningen — nordstjernetallet (f.eks. Stripe restricted key, kun lesing)
STRIPE_API_KEY=

# Annonsekontoen (Meta) — kun lesing
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=        # <DIN-ANNONSEKONTO-ID>

# CRM — nye kontakter per tagg (f.eks. GoHighLevel private integration, kun lesing)
CRM_API_TOKEN=
CRM_LOCATION_ID=           # <DIN-CRM-LOKASJON-ID>

# Oppgavelista (f.eks. Notion) — lese + opprette oppgaver
NOTION_TOKEN=
NOTION_TASKS_DB_ID=        # <DIN-OPPGAVE-DATABASE-ID>

# Slack — to kanaler, aldri samme innlegg i begge
SLACK_BOT_TOKEN=
SLACK_ANNONSEKANAL=        # <DIN-ANNONSE-KANAL>
SLACK_MARKEDSKANAL=        # <DIN-MARKEDS-KANAL>
