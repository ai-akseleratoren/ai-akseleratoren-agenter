# GoHighLevel (eller ditt CRM)
GHL_PIT_TOKEN=            # Private Integration Token med contacts + forms-tilgang
GHL_LOCATION_ID=          # location-ID for kontoen din
GHL_FORM_ID=              # ID på webinar-påmeldingsskjemaet (Forms-oversikten)

# Tagg-vakta: taggen sekvensene styres av
WEBINAR_TAGG_GAMMEL=      # taggen fra forrige webinar som skjemaet fortsatt setter
WEBINAR_TAGG_NY=          # taggen for NESTE webinar

# Meta Marketing API (kun for CPL-rapporten)
META_ADS_TOKEN=           # langlevd token med lesetilgang
META_AD_ACCOUNT=          # act_xxxxxxxxxx

# Webinar-plattform (valgfritt, fasit-sjekk — eksempel: Zoom server-til-server)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
