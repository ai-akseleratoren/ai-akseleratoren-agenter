# Ogilvy (annonseagenten). Kopier til .env og fyll inn. ALDRI sjekk .env inn i git.

# Meta Marketing API
META_ADS_TOKEN=
# Annonsekontoen, i formen act_<tall>
META_AD_ACCOUNT_ID=

# Oppsettvakten: hvor funn postes, og hvem som tagges
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# F.eks. "<@DIN-SLACK-BRUKER-ID> <@REGNSKAPSFORERENS-ID>"
ALERT_MENTIONS=
# Ukestak i EUR per leveringsland, mandag-søndag, f.eks. NO:4000,SE:2000
WEEKLY_CAP=
# Kampanjer som skal hoppes over (navnet inneholder), kommaseparert
EXCLUDE_CAMPAIGNS=

# Salgsrapporten og CPL fra CRM-et
GHL_TOKEN=
GHL_LOCATION_ID=
STRIPE_API_KEY=
