# Wenger — kopier til .env og fyll inn. ALDRI sjekk .env inn i git.

# --- Hvem er du i FPL ---
FPL_ENTRY_ID=          # ditt lag-ID: tallet i fantasy.premierleague.com/entry/<ID>/event/1
FPL_LEAGUE_ID=         # ID-en til minilligaen din, fra URL-en til ligaen
FPL_LEAGUE_NAME=

# --- Innlogging (kun for a LESE eget lag og UTFORE endringer) ---
# FPL bruker OIDC-innlogging. Logg inn i nettleseren, apne DevTools >
# Application > Local Storage, finn nokkelen som starter med "oidc.user:" og
# kopier verdien av refresh_token (eller hele JSON-en).
# Tokenen ROTERES ved hver bruk. Skriptet ma lagre den nye i FPL_TOKEN_FILE
# med en gang; det er den lagrede kopien som gjelder etter forste bruk.
# Dette er en innlogging til kontoen din — behandl den som et passord.
FPL_REFRESH_TOKEN=
FPL_TOKEN_FILE=        # f.eks. ~/.wenger/fpl-refresh-token

# --- Engangskode for endringer (forslag -> kode -> utfor) ---
# Hvor koden sendes. Den skal ga til deg, utenom chatten med agenten.
VARSEL_KANAL=          # telegram | sms | epost
VARSEL_MOTTAKER=       # din chat-ID, ditt nummer eller din adresse

# --- Varsling av rapporter (valgfritt) ---
SLACK_WEBHOOK_URL=
SLACK_KANAL=#fpl

# --- Valgfritt: YouTube Data API for kanalskraping ---
# Uten nokkel brukes kanalenes RSS-feed, som er gratis og holder i praksis.
YOUTUBE_API_KEY=

# --- Valgfritt: URL-en dashboardet publiseres til ---
# Settes forste gang, slik at alle senere runder oppdaterer SAMME side
# i stedet for a lage en ny hver uke.
ARTIFACT_URL=
