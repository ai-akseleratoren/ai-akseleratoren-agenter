# Kopier til .env i prosjektrota. .env skal ALDRI i git.
SITE_URL=
# Valgfritt: IndexNow-nøkkelen (fila <nøkkel>.txt må ligge i rota på nettsiden)
INDEXNOW_KEY=
# 1 hvis siden finnes på flere språk (krever hreflang + x-default)
SEO_MULTILANG=

# Trafikk: Google-tjenestekonto. Nøkkelfila skal ligge UTENFOR repoet (chmod 600)
GOOGLE_SA_KEY_FILE=
# Domain-eiendom: sc-domain:dittdomene.no   URL-eiendom: https://www.dittdomene.no/
GSC_SITE=
GA4_PROPERTY_ID=
