# Zoom-leads-agenten — nøkler. Kopier til .env i samme mappe og fyll inn.
# ALDRI sjekk .env inn i git (legg den i .gitignore først).

# Zoom Server-to-Server OAuth-app (lages på marketplace.zoom.us).
# Scopes du trenger: report:read:admin, recording:read:admin, user:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# E-postadressen til Zoom-brukeren som er vert for webinarene
ZOOM_USER_EMAIL=eksempel@example.com

# CRM (skrevet mot GoHighLevel — private integration token + location-ID)
CRM_API_TOKEN=
CRM_LOCATION_ID=

# Hvilken pipeline og hvilket steg leads skal havne i (valgfritt — defaults vist)
CRM_PIPELINE_NAME=Sales Pipeline
CRM_TARGET_STAGE=Engaged

# Hvor ringelistene lagres, relativt til mappa du kjører fra (valgfritt)
OUTPUT_DIR=ringelister

# Varsling når høstingen er ferdig (valgfritt — dropp den om du ikke bruker Slack)
SLACK_WEBHOOK_URL=
